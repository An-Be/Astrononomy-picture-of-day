# Server-only. Never prefix with NEXT_PUBLIC_, never commit real values.
# Free key from https://api.nasa.gov. Without it the app uses NASA's DEMO_KEY,
# which is fine locally but rate-limited (30 requests an hour per IP).
# In Vercel, add it as a Sensitive environment variable.
NASA_API_KEY=

# Optional: PostHog product analytics (docs/modules/analytics-posthog.md).
# Public by design: a project token can only send events, not read them.
# Leave both empty to keep analytics off. One PostHog project per tool.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
